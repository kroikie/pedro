rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (Firebase Auth UID)
    // Fields:
    //   - screenName: string (optional, 1-50 chars) - Player's screen name
    //   - displayName: string (optional, nullable, 1-50 chars) - Legacy fallback display name
    //   - avatarUrl: string (optional, nullable, <= 500 chars, http(s):// or gs://) - Player's avatar URL
    //   - fcmTokens: map (optional, nullable, <= 50 entries) - Device FCM push notification tokens
    //
    // Collection: games
    // Document ID: gameId (Firestore auto-id)
    // Fields:
    //   - hostId: string (required) - UID of player who created the game
    //   - name: string (required) - Room name
    //   - targetScore: int (required) - Winning score threshold (e.g. 35)
    //   - playerIds: list (required) - UIDs of players currently seated in the game
    //   - invitedPlayerIds: list (optional) - UIDs of invited players
    //   - status: string (required) - Room status ('waiting', 'starting', 'playing', 'finished')
    //   - isOpen: bool (optional) - True if the game is open for spectators once active
    //   - viewerIds: list (optional) - UIDs of users currently spectating
    //   - viewerHeartbeats: map (optional) - UID to epoch timestamp heartbeat leases
    //   - createdAt: timestamp (required) - Room creation timestamp
    //   - updatedAt: timestamp (optional) - Timestamp of last gameplay activity
    //   - currentRound: map (optional) - Active round and gameplay state
    //   (All mutations to games are strictly restricted to Cloud Functions via Admin SDK)
    //
    // Subcollection: games/{gameId}/messages
    // Document ID: messageId (Firestore auto-id)
    // Fields:
    //   - senderId: string (required, matches auth.uid) - UID of message sender
    //   - senderName: string (required, 1-50 chars) - Display name of sender
    //   - text: string (required, 1-1000 chars) - Message body
    //   - timestamp: timestamp (required) - Server timestamp when sent
    //   - isAi: bool (optional, must be false for client writes) - AI commentary flag
    //
    // Subcollection: games/{gameId}/reactions
    // Document ID: reactionId (Firestore auto-id)
    // Fields:
    //   - senderId: string (required, matches auth.uid) - UID of reactor
    //   - senderName: string (required, 1-50 chars) - Display name of reactor
    //   - emoji: string (required, 1-20 chars) - Reaction emoji character(s)
    //   - timestamp: timestamp (required) - Server timestamp when sent
    //
    // Subcollection: games/{gameId}/rounds
    // Document ID: round_{roundNumber}
    // Fields:
    //   - gameId: string (required) - Parent game room ID
    //   - roundNumber: int (required) - Sequential round number (1-indexed)
    //   - completedAt: timestamp (required) - Timestamp when the round concluded
    //   - isoWeek: string (required) - ISO week identifier (e.g. '2026-W41')
    //   - playerCount: int (required) - Number of seated players in the round
    //   - playerIds: list (required) - UIDs of seated players
    //   - dealerId: string (required) - UID of the round dealer
    //   - trumpSuit: string (required) - Selected trump suit
    //   - bidWinnerId: string (required) - UID of the winning bidder
    //   - bidValue: int (required) - Winning bid value
    //   - bidSuccess: bool (required) - True if the bid winner made their bid
    //   - bidMadeWinnerId: string (optional, nullable) - UID of player who made their bid
    //   - bidSetLoserId: string (optional, nullable) - UID of player who was set on their bid
    //   - highTrumpPlayerId: string (optional, nullable) - UID of player who won High Trump
    //   - highTrumpPlayedCard: map (optional, nullable) - Card details for High Trump
    //   - lowTrumpPlayerId: string (optional, nullable) - UID of player who won Low Trump
    //   - lowTrumpPlayedCard: map (optional, nullable) - Card details for Low Trump
    //   - hangJackWinnerId: string (optional, nullable) - UID of player who captured the Jack of Trump
    //   - jackHungVictimId: string (optional, nullable) - UID of player whose Jack of Trump was captured
    //   - savedJackWinnerId: string (optional, nullable) - UID of player who saved their own Jack of Trump
    //   - fiveTrumpWinnerId: string (optional, nullable) - UID of player who won the Five of Trump
    //   - fiveTrumpLoserId: string (optional, nullable) - UID of player who lost the Five of Trump
    //   - nineTrumpWinnerId: string (optional, nullable) - UID of player who won the Nine of Trump
    //   - nineTrumpLoserId: string (optional, nullable) - UID of player who lost the Nine of Trump
    //   - gameWinnerId: string (optional, nullable) - UID of player who won the Game point
    //   - gameWinningScore: int (optional, nullable) - Card point total that won the Game point
    //   - isGameTied: bool (required) - True if the Game point was tied
    //   - matchWinnerId: string (optional, nullable) - UID of player who won the match on this round
    //   - playerSummaries: map (required) - Per-player round breakdown map keyed by UID
    //   - heists: list (required) - Directed card captures (Jack, Nine, Five of Trump)
    //   - completedLifts: list (required) - Ordered list of completed lifts in the round
    //   (All mutations to rounds are strictly restricted to Cloud Functions via Admin SDK)
    //
    // Collection: leaderboards
    // Document ID: periodId (e.g. 'all_time', '2026-W41')
    //
    // Subcollection: leaderboards/{periodId}/players
    // Document ID: userId (Firebase Auth UID)
    // Description: Materialized player Triumph & Hall of Shame leaderboard rollup counters
    // Fields:
    //   - uid: string (required) - Player's Firebase Auth UID
    //   - screenName: string (required) - Player's display name
    //   - avatarUrl: string (optional, nullable) - Player's avatar URL
    //   - periodId: string (required) - Leaderboard period identifier
    //   - hangJacks: int (required) - Count of opponent Jacks of Trump captured
    //   - jacksSaved: int (required) - Count of own Jacks of Trump saved
    //   - highTrumps: int (required) - Count of High Trump points won
    //   - lowTrumps: int (required) - Count of Low Trump points won
    //   - fivesWon: int (required) - Count of Five of Trump captures
    //   - ninesWon: int (required) - Count of Nine of Trump captures
    //   - gamePointsWon: int (required) - Count of Game points won
    //   - bidsWon: int (required) - Count of auctions won
    //   - bidsMade: int (required) - Count of bids successfully made
    //   - gamesWon: int (required) - Count of matches won
    //   - totalPointsEarned: int (required) - Cumulative Pedro points earned
    //   - jacksHung: int (required) - Count of times player's Jack of Trump was captured
    //   - ninesLost: int (required) - Count of times player's Nine of Trump was captured
    //   - fivesLost: int (required) - Count of times player's Five of Trump was captured
    //   - bidsSet: int (required) - Count of times player was set on their bid
    //   - roundsPlayed: int (required) - Total rounds played in period
    //   - gamesPlayed: int (required) - Total matches completed in period
    //   - updatedAt: timestamp (required) - Last rollup update timestamp
    //
    // Subcollection: leaderboards/{periodId}/rivalries
    // Document ID: rivalryId ({actorUid}_{victimUid})
    // Description: Materialized directed head-to-head rivalry counters
    // Fields:
    //   - id: string (required) - Directed rivalry identifier ({actorUid}_{victimUid})
    //   - periodId: string (required) - Leaderboard period identifier
    //   - actorUid: string (required) - UID of the capturing/winning player
    //   - actorName: string (required) - Display name of the actor
    //   - actorAvatarUrl: string (optional, nullable) - Avatar URL of the actor
    //   - victimUid: string (required) - UID of the victim player
    //   - victimName: string (required) - Display name of the victim
    //   - victimAvatarUrl: string (optional, nullable) - Avatar URL of the victim
    //   - jacksHung: int (required) - Count of times actor hung victim's Jack of Trump
    //   - ninesStolen: int (required) - Count of times actor stole victim's Nine of Trump
    //   - fivesStolen: int (required) - Count of times actor stole victim's Five of Trump
    //   - heistCount: int (required) - Total high-value trump thefts by actor against victim
    //   - heistPoints: int (required) - Total points stolen by actor from victim via heists
    //   - matchesWonAgainst: int (required) - Count of matches won by actor against victim
    //   - updatedAt: timestamp (required) - Last rivalry update timestamp
    //   (All mutations to leaderboards and its subcollections are strictly restricted to Cloud Functions / Admin CLI via Admin SDK)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user matches the specified userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate that a timestamp is recent (within 5 minutes) and not in the future
    function isRecent(time) {
      return time is timestamp &&
             time > request.time - duration.value(5, 'm') &&
             time <= request.time;
    }

    // Check if user is the host, a seated player, or an invited player for the game
    function isGameParticipant() {
      return request.auth.uid == resource.data.hostId ||
             request.auth.uid in resource.data.playerIds ||
             (resource.data.invitedPlayerIds != null && request.auth.uid in resource.data.invitedPlayerIds);
    }

    // Check if user is a participant or if the game is open and playing or finished
    function canViewGame() {
      return isGameParticipant() || 
             (resource.data.isOpen == true && (resource.data.status == 'playing' || resource.data.status == 'finished'));
    }

    // Check if user is a participant or if the game is open and playing or finished by fetching parent game document
    function canViewGameById(gameId) {
      let game = get(/databases/$(database)/documents/games/$(gameId)).data;
      return request.auth.uid == game.hostId ||
             request.auth.uid in game.playerIds ||
             (game.invitedPlayerIds != null && request.auth.uid in game.invitedPlayerIds) ||
             (game.isOpen == true && (game.status == 'playing' || game.status == 'finished'));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validator for User Profile documents (/users/{userId})
    function isValidUser(data) {
      return data.keys().hasOnly(['screenName', 'avatarUrl', 'fcmTokens', 'displayName']) &&
             (!('screenName' in data) || 
               (data.screenName is string && 
                data.screenName.size() >= 1 && 
                data.screenName.size() <= 50)) &&
             (!('displayName' in data) || 
               data.displayName == null || 
               (data.displayName is string && 
                data.displayName.size() >= 1 && 
                data.displayName.size() <= 50)) &&
             (!('avatarUrl' in data) || 
               data.avatarUrl == null || 
               (data.avatarUrl is string && 
                data.avatarUrl.size() <= 500 && 
                (data.avatarUrl.size() == 0 || 
                 data.avatarUrl.matches("^https?://.*") || 
                 data.avatarUrl.matches("^gs://.*")))) &&
             (!('fcmTokens' in data) || 
               data.fcmTokens == null || 
               (data.fcmTokens is map && 
                data.fcmTokens.size() <= 50));
    }

    // Validator for Chat Message documents (/games/{gameId}/messages/{messageId})
    function isValidMessage(data) {
      return data.keys().hasOnly(['senderId', 'senderName', 'text', 'timestamp', 'isAi']) &&
             data.keys().hasAll(['senderId', 'senderName', 'text', 'timestamp']) &&
             data.senderId is string && 
             data.senderId == request.auth.uid &&
             data.senderName is string && 
             data.senderName.size() >= 1 && 
             data.senderName.size() <= 50 &&
             data.text is string && 
             data.text.size() >= 1 && 
             data.text.size() <= 1000 &&
             data.timestamp is timestamp && 
             (data.timestamp == request.time || isRecent(data.timestamp)) &&
             (!('isAi' in data) || (data.isAi is bool && data.isAi == false));
    }

    // Validator for Reaction documents (/games/{gameId}/reactions/{reactionId})
    function isValidReaction(data) {
      return data.keys().hasOnly(['senderId', 'senderName', 'emoji', 'timestamp']) &&
             data.keys().hasAll(['senderId', 'senderName', 'emoji', 'timestamp']) &&
             data.senderId is string && 
             data.senderId == request.auth.uid &&
             data.senderName is string && 
             data.senderName.size() >= 1 && 
             data.senderName.size() <= 50 &&
             data.emoji is string && 
             data.emoji.size() >= 1 && 
             data.emoji.size() <= 20 &&
             data.timestamp is timestamp && 
             (data.timestamp == request.time || isRecent(data.timestamp));
    }

    // ===============================================================
    // Rules Definitions
    // ===============================================================

    // Users Collection
    match /users/{userId} {
      // Authenticated users can view profiles (to invite friends or inspect opponents)
      allow read: if isAuthenticated();

      // Only the user themselves can create or update their profile, with strict schema validation
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;
    }

    // Games Collection
    match /games/{gameId} {
      // Game participants or spectators (if open and playing or finished) can read game room state
      allow read: if isAuthenticated() && canViewGame();

      // All game modifications are orchestrated via secure Cloud Functions
      allow write: if false;

      // In-game Messages Subcollection
      match /messages/{messageId} {
        // Authenticated participants or spectators can read game chat
        allow read: if isAuthenticated() && canViewGameById(gameId);

        // Authenticated participants or spectators can send messages matching their UID with validated content
        allow create: if isAuthenticated() && canViewGameById(gameId) && isValidMessage(request.resource.data);
        allow update, delete: if false;
      }

      // In-game Floating Reactions Subcollection
      match /reactions/{reactionId} {
        // Authenticated participants or spectators can view reactions
        allow read: if isAuthenticated() && canViewGameById(gameId);

        // Authenticated participants or spectators can send emoji reactions matching their UID with length limits
        allow create: if isAuthenticated() && canViewGameById(gameId) && isValidReaction(request.resource.data);
        allow update, delete: if false;
      }

      // Completed Round Archives Subcollection
      match /rounds/{roundId} {
        // Authenticated participants or spectators of the game can read archived round summaries
        allow read: if isAuthenticated() && canViewGameById(gameId);

        // All round archives are written exclusively by Cloud Functions via Admin SDK
        allow write: if false;
      }
    }

    // Leaderboards Collection & Materialized Rollup Subcollections
    match /leaderboards/{periodId} {
      // Authenticated users can read leaderboard period metadata
      allow read: if isAuthenticated();
      allow write: if false;

      // Materialized Player Triumph & Hall of Shame Rollups
      match /players/{userId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      // Materialized Directed Head-to-Head Rivalry Rollups
      match /rivalries/{rivalryId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }
  }
}
